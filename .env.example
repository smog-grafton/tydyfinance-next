# Public Next.js origin. Must be the deployed browser origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laravel API origin. This is intentionally public because browser requests use it.
NEXT_PUBLIC_LARAVEL_URL=http://localhost:8000

# Name of the Laravel session cookie shared with this Next.js application.
# Do not put cookie values or credentials in this file.
LARAVEL_SESSION_COOKIE=tydyfinance-session
